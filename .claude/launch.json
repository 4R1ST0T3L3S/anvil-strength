{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "anvil-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321,
      "autoPort": false
    },
    {
      "name": "landing-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--outDir",
