# Herramientas de asistente instaladas localmente. Son 2,5 MB de skills
# vendorizadas: no forman parte del proyecto y cada actualización metería un
# diff enorme sin relación con el código.
.agents/
skills-lock.json

# Originales de las imagenes antes de optimizar (scripts/optimizar-imagenes.mjs).
# No se versionan: siguen en el historial de git, que es de donde se recuperan
# de verdad. Esta carpeta es solo la comodidad de un "--restaurar" inmediato.
assets-originales/

# Basura de la CLI de Supabase. `project-ref` SÍ se versiona: es lo que hace
# que `supabase functions deploy` funcione recién clonado, y no es un secreto
# (el ref va en la URL del proyecto y en el bundle del cliente).
supabase/.temp/cli-latest
.vercel
.env*

# Volcados de terminal y reportes de herramientas. Se regeneran con un comando
# y envejecen mal: un `lint_errors.txt` de hace tres meses solo miente. Se miran
# en local y se tiran.
git_log.txt
git_status*.txt
lint_errors.*
lint_output.*
build_output.log
ts_errors.log
eslint_report.json

# Scripts de un solo uso (codemods ya aplicados, sondas de depuracion).
fix_*.cjs
find_*.cjs
live_site.js
