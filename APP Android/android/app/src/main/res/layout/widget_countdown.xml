<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_dark"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- TU PRÓXIMO RETO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 TU PRÓXIMO RETO"
        android:textColor="#cbd5e1"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- NOMBRE DE LA COMPE -->
    <TextView
        android:id="@+id/widget_comp_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EPF KRAJNSKA GORA"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="4dp"/>

    <!-- LOCATION -->
    <TextView
        android:id="@+id/widget_comp_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 Krajnska Gora"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- CAJAS DE TIEMPO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        android:weightSum="2">

        <!-- DÍAS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_box"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="94"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÍAS"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- HORAS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_box"
            android:layout_marginStart="4dp">
            <TextView
                android:id="@+id/widget_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HORAS"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
