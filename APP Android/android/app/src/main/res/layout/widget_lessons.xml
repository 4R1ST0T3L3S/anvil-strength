<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_box"
    android:padding="20dp">

    <!-- Marca de agua gigante -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="”"
        android:textColor="#33ffffff"
        android:textSize="120sp"
        android:fontFamily="sans-serif-black"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-10dp" />

    <TextView
        android:id="@+id/widget_lessons_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📖 ANVIL LESSONS"
        android:textColor="#eab308"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="8dp"/>

    <!-- La frase -->
    <TextView
        android:id="@+id/widget_lesson_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOY NO SE ENTRENA, HOY SE SOBREVIVE."
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Subtítulo inferior -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ANVIL STRENGTH CLUB"
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:gravity="center"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
